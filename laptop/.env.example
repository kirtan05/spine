# Copy to laptop/.env and fill in. Never commit .env.
#
# The Worker exposes no admin surface by design, so every write to D1 beyond the
# kosync protocol comes through this token. Scope it to D1:Edit on one account
# (DEPLOY.md step 10) — it is not a global API key and must never be one.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Paths. Defaults shown; uncomment to override.
#SPINE_DATA_DIR=~/spine-data
#SHELF_INBOX=~/inbox
#SHELF_LIBRARY=~/library
#SHELF_QUARANTINE=~/quarantine

# Optional KCC pass to pre-rotate two-page spreads.
#
# Turning this on changes the bytes of every comic it touches, and therefore
# every doc_hash. Decide before books reach a reader, never after: flipping it on
# later forks every affected book and orphans its progress and history.
#
# One profile for all devices, always. A per-device render produces per-device
# hashes, which is the exact failure this system exists to prevent.
#SHELF_SPREADS=false
#SHELF_SPREADS_PROFILE=KoL
